# Environment variables for the Recall MCP memory server.
# Copy to .env and fill in real values. Never commit .env.

# --- Database ----------------------------------------------------------------
# Postgres with pgvector extension. The schema is created/upgraded by
# `recall db migrate` (or auto-migrate on startup if RECALL_AUTO_MIGRATE=1).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recall

# --- Embeddings --------------------------------------------------------------
# OpenAI or any OpenAI-compatible endpoint (Azure, vLLM, LM Studio, etc.).
OPENAI_API_KEY=sk-...
# Optional override; defaults to text-embedding-3-small (1536 dims).
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional override for the API base.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Server ------------------------------------------------------------------
# Streamable HTTP MCP transport — bind address and port.
RECALL_HOST=0.0.0.0
RECALL_PORT=8080

# --- Auth (see REQUIREMENTS.md S3.5; choice is still open) -------------------
# One of: bearer | oidc | mtls
RECALL_AUTH_MODE=bearer
# When RECALL_AUTH_MODE=bearer, the path to the user→token mapping file.
# RECALL_BEARER_TOKENS_FILE=/etc/recall/tokens.json

# --- Operations --------------------------------------------------------------
# Run schema migrations automatically on startup (otherwise use the CLI).
RECALL_AUTO_MIGRATE=0
# Log level: debug | info | warn | error
RECALL_LOG_LEVEL=info
