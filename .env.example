# Environment variables for the Recall MCP memory server.
# Copy to .env and fill in real values. Never commit .env.
# `recall db migrate` needs only DATABASE_URL and EMBEDDINGS_DIM.

# --- Required ----------------------------------------------------------------
# Postgres with the pgvector extension.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recall
# Path to the bearer token file (ADR-0007): {"<token>": {"user_id": "<id>"}}
RECALL_AUTH_FILE=/etc/recall/auth.json

# --- Embeddings --------------------------------------------------------------
# openai | sentence-transformers | stub (tests and local development only)
EMBEDDINGS_PROVIDER=openai
# Vector dimension. Required; fixes the database column when it is first created.
EMBEDDINGS_DIM=1536
# Required for openai and sentence-transformers.
EMBEDDINGS_MODEL=text-embedding-3-small
# Required for openai: any OpenAI-compatible endpoint.
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_API_KEY=sk-...
# EMBEDDINGS_TIMEOUT_SECONDS=10

# --- Server (optional) -------------------------------------------------------
# RECALL_HOST=0.0.0.0
# RECALL_PORT=8080
# LOG_LEVEL=INFO
# RECALL_DB_MIGRATE_ON_STARTUP=true
# Comma-separated hostnames. Empty means no Host check.
# RECALL_ALLOWED_HOSTS=

# --- Search (optional) -------------------------------------------------------
# RECALL_PROJECT_BOOST=0.05
# RECALL_DEFAULT_LIMIT=10
# RECALL_MAX_LIMIT=50
# RECALL_SNIPPET_MAX_CHARS=200
